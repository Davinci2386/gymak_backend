NODE_ENV=development
PORT=3000

# Local development (outside Docker)
DATABASE_URL=postgresql://workout_user:change_me@localhost:5432/workout_db

# Docker Compose
POSTGRES_DB=workout_db
POSTGRES_USER=workout_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DOCKER_DATABASE_URL=postgresql://workout_user:change_me@postgres:5432/workout_db

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ImageKit
IMAGEKIT_PUBLIC_KEY=public_replace_me
IMAGEKIT_PRIVATE_KEY=private_replace_me
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/replace_me

# Firebase Admin SDK
FIREBASE_PROJECT_ID=replace_me
FIREBASE_CLIENT_EMAIL=replace_me@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"
