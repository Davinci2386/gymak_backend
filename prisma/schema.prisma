// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  TRAINER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum TrainerRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  gender       Gender?
  birthDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                UserSession[]
  sentTrainerRequests     TrainerRequest[]    @relation("sentTrainerRequests")
  receivedTrainerRequests TrainerRequest[]    @relation("receivedTrainerRequests")
  playerAssignments       TrainerAssignment[] @relation("playerAssignments")
  trainerAssignments      TrainerAssignment[] @relation("trainerAssignments")
  trainerProfile          TrainerProfile?
  subscriptions           Subscription[]
  payments                Payment[]

  @@index([email])
}

model TrainerProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificates TrainerCertificate[]
}

model TrainerCertificate {
  id        String @id @default(uuid())
  profileId String
  fileName  String
  mimeType  String
  path      String

  createdAt DateTime @default(now())

  profile TrainerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TrainerRequest {
  id        String               @id @default(uuid())
  playerId  String
  trainerId String
  status    TrainerRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player  User @relation("sentTrainerRequests", fields: [playerId], references: [id], onDelete: Cascade)
  trainer User @relation("receivedTrainerRequests", fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([playerId, trainerId, status])
  @@index([playerId])
  @@index([trainerId])
}

model TrainerAssignment {
  id        String           @id @default(uuid())
  playerId  String
  trainerId String
  status    AssignmentStatus @default(ACTIVE)
  startedAt DateTime         @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player  User @relation("playerAssignments", fields: [playerId], references: [id], onDelete: Cascade)
  trainer User @relation("trainerAssignments", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([trainerId])
  @@index([status])
}

model WorkoutPlan {
  id        String      @id @default(uuid())
  slug      String      @unique
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  days      WorkoutDay[]
}

model WorkoutDay {
  id        String            @id @default(uuid())
  planId    String
  dayNumber Int
  label     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  plan      WorkoutPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@unique([planId, dayNumber])
  @@index([planId])
}

model WorkoutExercise {
  id          String    @id @default(uuid())
  dayId       String
  name        String
  description String    @default("")
  imageUrls   String[]  @default([])
  videoUrl    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  day         WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

enum MealSection {
  BREAKFAST
  LUNCH
  DINNER
}

model NutritionMeal {
  id          String                @id @default(uuid())
  section     MealSection
  name        String
  imageUrl    String
  calories    Int
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  ingredients NutritionIngredient[]

  @@index([section])
}

model NutritionIngredient {
  id        String        @id @default(uuid())
  mealId    String
  name      String
  quantity  String
  calories  Int
  sortOrder Int           @default(0)
  meal      NutritionMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
}

model SubscriptionPlan {
  id          String @id @default(uuid())
  name        String @unique
  description String?
  price       Int    // بـ cents (الحد الأدنى للـ Stripe)
  durationDays Int    // مدة الاشتراك بـ أيام
  features    String[] @default([])
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]

  @@index([isActive])
}

model Subscription {
  id              String               @id @default(uuid())
  userId          String
  planId          String
  status          SubscriptionStatus   @default(ACTIVE)
  stripeCustomerId String?
  startDate       DateTime             @default(now())
  endDate         DateTime
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan  SubscriptionPlan   @relation(fields: [planId], references: [id])
  payments Payment[]

  @@unique([userId, planId, status])
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  subscriptionId    String?
  planId            String
  status            PaymentStatus @default(PENDING)
  amount            Int           // بـ cents
  stripePaymentIntentId String?  @unique
  stripeChargeId    String?       @unique
  currency          String        @default("USD")
  errorMessage      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([status])
  @@index([stripePaymentIntentId])
}
