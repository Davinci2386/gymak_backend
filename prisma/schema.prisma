// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  TRAINER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum TrainerRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AccountStatus {
  ACTIVE
  DELETED
  SUSPENDED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
  UNKNOWN
}

enum NotificationTargetType {
  USER
  TRAINER
  BROADCAST
}

enum NotificationLogStatus {
  SENT
  PARTIAL
  FAILED
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String        @id @default(uuid())
  firstName        String
  lastName         String
  email            String        @unique
  passwordHash     String
  role             Role          @default(USER)
  accountStatus    AccountStatus @default(ACTIVE)
  gender           Gender?
  birthDate        DateTime?
  goals            String[]      @default([])
  hasRoutine       Boolean       @default(false)
  trainTime        String?
  heightCm         Float         @default(0)
  weightKg         Float         @default(0)
  medicalCondition String?
  injuries         String?
  medications      String?
  deletedAt        DateTime?
  deletedByAdminId String?
  deletionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                     UserSession[]
  sentTrainerRequests          TrainerRequest[]         @relation("sentTrainerRequests")
  receivedTrainerRequests      TrainerRequest[]         @relation("receivedTrainerRequests")
  playerAssignments            TrainerAssignment[]      @relation("playerAssignments")
  trainerAssignments           TrainerAssignment[]      @relation("trainerAssignments")
  trainerProfile               TrainerProfile?
  subscriptions                Subscription[]
  payments                     Payment[]
  workoutPlansAsPlayer         WorkoutPlan[]            @relation("playerWorkoutPlans")
  workoutPlansAsTrainer        WorkoutPlan[]            @relation("trainerWorkoutPlans")
  nutritionMealsAsPlayer       NutritionMeal[]          @relation("playerNutritionMeals")
  nutritionMealsAsTrainer      NutritionMeal[]          @relation("trainerNutritionMeals")
  nutritionCatalogMealsCreated NutritionCatalogMeal[]   @relation("trainerCreatedNutritionCatalogMeals")
  songsCreated                 Song[]                   @relation("adminCreatedSongs")
  workoutCatalogExercises      WorkoutCatalogExercise[]
  profileImages                UserProfileImage[]
  deviceTokens                 DeviceToken[]
  userNotifications            UserNotification[]
  postsAuthored                Post[]                   @relation("trainerPosts")
  reviewedPosts                Post[]                   @relation("adminReviewedPosts")

  @@index([email])
  @@index([accountStatus])
  @@index([role, accountStatus])
}

model UserProfileImage {
  id        String   @id @default(uuid())
  userId    String
  url       String
  fileId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform @default(UNKNOWN)
  deviceName String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@index([lastSeenAt])
}

model NotificationLog {
  id               String                 @id @default(uuid())
  createdByAdminId String?
  targetType       NotificationTargetType
  targetUserId     String?
  audienceRole     Role?
  title            String
  body             String
  data             Json?
  sentCount        Int                    @default(0)
  failedCount      Int                    @default(0)
  status           NotificationLogStatus  @default(SENT)
  failureReason    String?
  createdAt        DateTime               @default(now())

  @@index([createdByAdminId])
  @@index([targetType])
  @@index([targetUserId])
  @@index([audienceRole])
  @@index([createdAt])
}

model UserNotification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Post {
  id                String     @id @default(uuid())
  trainerId         String
  content           String
  imageUrl          String?
  imageFileId       String?
  status            PostStatus @default(PENDING)
  reviewedByAdminId String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  trainer         User  @relation("trainerPosts", fields: [trainerId], references: [id], onDelete: Cascade)
  reviewedByAdmin User? @relation("adminReviewedPosts", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([trainerId])
  @@index([status])
  @@index([createdAt])
  @@index([reviewedByAdminId])
}

model PrivacyPolicy {
  id        Int      @id @default(1)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Song {
  id               String   @id @default(uuid())
  title            String
  artist           String
  coverImageUrl    String
  mp3Url           String
  durationSeconds  Int
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdByAdmin User? @relation("adminCreatedSongs", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([artist])
  @@index([createdAt])
  @@index([createdByAdminId])
}

model TrainerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  description  String?
  certificates String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyCertificateFiles TrainerCertificate[]
}

model TrainerCertificate {
  id        String @id @default(uuid())
  profileId String
  fileName  String
  mimeType  String
  path      String

  createdAt DateTime @default(now())

  profile TrainerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TrainerRequest {
  id        String               @id @default(uuid())
  playerId  String
  trainerId String
  status    TrainerRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player  User @relation("sentTrainerRequests", fields: [playerId], references: [id], onDelete: Cascade)
  trainer User @relation("receivedTrainerRequests", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([trainerId])
  @@index([playerId, trainerId, status])
}

model TrainerAssignment {
  id        String           @id @default(uuid())
  playerId  String
  trainerId String
  status    AssignmentStatus @default(ACTIVE)
  startedAt DateTime         @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player  User @relation("playerAssignments", fields: [playerId], references: [id], onDelete: Cascade)
  trainer User @relation("trainerAssignments", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([trainerId])
  @@index([status])
}

model WorkoutPlan {
  id        String       @id @default(uuid())
  slug      String       @unique
  title     String?
  playerId  String?
  trainerId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  days      WorkoutDay[]
  player    User?        @relation("playerWorkoutPlans", fields: [playerId], references: [id], onDelete: Cascade)
  trainer   User?        @relation("trainerWorkoutPlans", fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([playerId, trainerId])
  @@index([playerId])
  @@index([trainerId])
}

model WorkoutDay {
  id        String            @id @default(uuid())
  planId    String
  dayNumber Int
  label     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  plan      WorkoutPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@unique([planId, dayNumber])
  @@index([planId])
}

model WorkoutExercise {
  id          String      @id @default(uuid())
  dayId       String
  name        String
  description String      @default("")
  imageUrls   String[]    @default([])
  videoUrl    String?
  muscleGroup MuscleGroup @default(CARDIO)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  day         WorkoutDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@index([muscleGroup])
}

enum MealSection {
  BREAKFAST
  LUNCH
  DINNER
}

enum MuscleGroup {
  BICEPS
  TRICEPS
  CHEST
  LEGS
  BACK
  SHOULDERS
  CARDIO
}

model WorkoutCatalogExercise {
  id          String      @id @default(uuid())
  name        String
  description String      @default("")
  imageUrls   String[]    @default([])
  videoUrl    String?
  muscleGroup MuscleGroup
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([muscleGroup])
  @@index([name])
  @@index([createdById])
}

model NutritionMeal {
  id          String                @id @default(uuid())
  playerId    String?
  trainerId   String?
  section     MealSection
  name        String
  imageUrl    String
  calories    Int
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  ingredients NutritionIngredient[]
  player      User?                 @relation("playerNutritionMeals", fields: [playerId], references: [id], onDelete: Cascade)
  trainer     User?                 @relation("trainerNutritionMeals", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([section])
  @@index([playerId])
  @@index([trainerId])
}

model NutritionCatalogMeal {
  id          String                       @id @default(uuid())
  section     MealSection
  name        String
  imageUrl    String
  calories    Int
  createdById String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  ingredients NutritionCatalogIngredient[]
  createdBy   User?                        @relation("trainerCreatedNutritionCatalogMeals", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([section])
  @@index([name])
  @@index([createdById])
}

model NutritionCatalogIngredient {
  id        String               @id @default(uuid())
  mealId    String
  name      String
  quantity  String
  calories  Int
  sortOrder Int                  @default(0)
  meal      NutritionCatalogMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
}

model NutritionIngredient {
  id        String        @id @default(uuid())
  mealId    String
  name      String
  quantity  String
  calories  Int
  sortOrder Int           @default(0)
  meal      NutritionMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  price        Int // بـ cents (الحد الأدنى للـ Stripe)
  durationDays Int // مدة الاشتراك بـ أيام
  features     String[] @default([])
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]

  @@index([isActive])
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  stripeCustomerId String?
  startDate        DateTime           @default(now())
  endDate          DateTime
  cancelledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@unique([userId, planId, status])
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String
  subscriptionId        String?
  planId                String
  status                PaymentStatus @default(PENDING)
  amount                Int // بـ cents
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?       @unique
  currency              String        @default("USD")
  errorMessage          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?    @relation(fields: [subscriptionId], references: [id])
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([status])
  @@index([stripePaymentIntentId])
}
